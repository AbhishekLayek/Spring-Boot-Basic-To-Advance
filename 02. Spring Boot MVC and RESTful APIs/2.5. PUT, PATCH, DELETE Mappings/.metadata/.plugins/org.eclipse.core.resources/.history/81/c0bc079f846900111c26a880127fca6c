package com.spring.SpringMVC.controllers;

import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import com.spring.SpringMVC.configs.ModelMapperConfig;
import com.spring.SpringMVC.services.EmployeeService;

@RestController
@RequestMapping("/employees")
public class EmployeeController {
	
	private final EmployeeService empService;
	private final ModelMapperConfig modelMapper;
	
	public EmployeeController(EmployeeService empService, ModelMapperConfig modelMapper) {
		this.empService = empService;
		this.modelMapper = modelMapper;
	}
	
	
}
