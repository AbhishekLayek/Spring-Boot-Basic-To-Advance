package com.spring.Beans;

import org.springframework.stereotype.Component;

/* @Component is a class level annotation used to mark a class as a spring managed bean.
 * When spring scans the application, it detecs classes annotated with @Component and registers them as beans in the Spring IoC container.
*/
@Component
public class PaymentService {
	public void pay() {
		System.out.println("Paying...");
	}
}
